{
  "name": "@clickland/schema",
  "version": "0.1.0",
  "private": true,
  "description": "Clickland's storage schema: ClickHouse tables (ClickStack-compatible) and Postgres metadata, with their migration runner.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate": "node dist/cli.js"
  },
  "dependencies": {
    "@clickhouse/client": "^1.12.1",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
